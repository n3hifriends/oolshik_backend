# ── Image ─────────────────────────────────────────────────────────────────────
IMAGE_URI=653895707563.dkr.ecr.ap-south-1.amazonaws.com/oolshik-api:latest

# ── Database ──────────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://oolshik-dev-ap-south-1-rds.c1acsg0uu5qk.ap-south-1.rds.amazonaws.com:5432/oolshik?sslmode=require
SPRING_DATASOURCE_USERNAME=oolshik_admin
SPRING_DATASOURCE_PASSWORD=Ndroid11!

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=qJPx4JLUBnUxaqVvUvt15biE5g7pb5WRqRrA085zDis=

APP_AUTH_GOOGLE_ENABLED=true
APP_AUTH_GOOGLE_REQUIRE_PHONE=true
APP_AUTH_GOOGLE_AUTO_LINK_BY_EMAIL=false
APP_AUTH_GOOGLE_ALLOWED_CLIENT_IDS=263296903071-l80n6ccefcn05s5apnobtlpl1cc0fd5t.apps.googleusercontent.com,263296903071-v73slipdgnp9ffj4vlnav47usqpf4l3t.apps.googleusercontent.com,263296903071-e6t5p5s4on6naqbkpieo1enrudr2d6ch.apps.googleusercontent.com

# ── Firebase ──────────────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=oolshik
FIREBASE_CHECK_REVOKED=false
FIREBASE_SA_JSON_PATH=/etc/oolshik-backend/firebase-sa.json

# Push notification provider: FCM (direct) or EXPO (via Expo Push API)
ADMIN_NOTIF_PUSH_PROVIDER=FCM

# ── OTP ───────────────────────────────────────────────────────────────────────
APP_OTP_PROVIDER=dev
APP_OTP_DEV_ENABLED=true
# MSG91 values only needed when APP_OTP_PROVIDER=msg91
# APP_OTP_MSG91_API_KEY=FILL_ME_IN
# APP_OTP_MSG91_TEMPLATE_ID=FILL_ME_IN
# APP_OTP_MSG91_SENDER_ID=FILL_ME_IN
# APP_OTP_MSG91_ENTITY_ID=FILL_ME_IN

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=10.20.0.13:9092
APP_MESSAGING_KAFKA_ENABLED=true
KAFKA_CONSUMER_GROUP=oolshik-stt-backend

# ── Media / S3 ────────────────────────────────────────────────────────────────
MEDIA_STORAGE=s3
MEDIA_S3_BUCKET=oolshik-dev-ap-south-1-storage-6538
MEDIA_S3_REGION=ap-south-1

# ── STT ───────────────────────────────────────────────────────────────────────
STT_AUDIO_SOURCE_MODE=S3_ONLY

# ── CORS ──────────────────────────────────────────────────────────────────────
APP_CORS_ALLOWED_ORIGINS=https://www.oolshik.in,https://oolshik.in

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=ap-south-1
APP_SECRETS_AWS_ENABLED=false
APP_SECRETS_AWS_DB_SECRET_NAME=oolshik/dev/db
APP_SECRETS_AWS_APP_SECRET_NAME=oolshik/dev/app

# ── Runtime ───────────────────────────────────────────────────────────────────
JAVA_OPTS=-Xmx512m
LOG_LEVEL=INFO
