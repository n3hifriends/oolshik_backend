# ── Image ─────────────────────────────────────────────────────────────────────
IMAGE_URI=653895707563.dkr.ecr.ap-south-1.amazonaws.com/oolshik-notification-worker:latest

# ── Database ──────────────────────────────────────────────────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://oolshik-dev-ap-south-1-rds.c1acsg0uu5qk.ap-south-1.rds.amazonaws.com:5432/oolshik?sslmode=require
SPRING_DATASOURCE_USERNAME=oolshik_admin
SPRING_DATASOURCE_PASSWORD=Ndroid11!

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=10.20.0.13:9092
KAFKA_CONSUMER_GROUP=notification-worker-v1
KAFKA_TOPIC_NOTIFICATION_EVENTS=notification.events

# ── Expo Push ─────────────────────────────────────────────────────────────────
EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
NOTIF_WORKER_MAX_SEND_ATTEMPTS=3
NOTIF_COALESCE_WINDOW_SECONDS=10
NOTIF_EXPO_BATCH_SIZE=100

# ── Runtime ───────────────────────────────────────────────────────────────────
JAVA_OPTS=-Xmx384m
LOG_LEVEL=INFO
# MEMORY_LIMIT=1g  # uncomment and set based on instance size
