# Copy this file to .env (gitignored) and fill in your values.
#
# PROFILES
# --------
# local      — IDE / no Docker. Uses local Postgres on the host.
# docker     — docker-compose up. api + db only by default.
#              APP_MESSAGING_KAFKA_ENABLED=true docker compose --profile full up
#              → also starts kafka, stt-worker, notification-worker
# cloud-dev  — Neon DB + msg91 OTP + S3. Used for cloud staging.
# prod       — Production on AWS. Uses RDS / RDS Proxy + S3 + FCM + Firebase auth.

SPRING_PROFILES_ACTIVE=local

# ── DB MODE ──────────────────────────────────────────────────────────────────
# local / docker  → builds JDBC URL from DB_HOST / DB_PORT / DB_NAME / DB_USER / DB_PASSWORD
# neon            → maps NEON_DATASOURCE_URL / USERNAME / PASSWORD
# rds             → maps RDS_HOSTNAME / RDS_PORT / RDS_DB_NAME / RDS_USERNAME / RDS_PASSWORD
APP_DB_MODE=local

# ── LOCAL / DOCKER DB ────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=oolshik
DB_USER=oolshik
DB_PASSWORD=oolshik
# DB_SSLMODE=prefer   # set to 'disable' for local no-TLS setups

# ── NEON DB (cloud-dev) ──────────────────────────────────────────────────────
# NEON_DATASOURCE_URL=jdbc:postgresql://...neon.tech/oolshik?sslmode=require
# NEON_DATASOURCE_USERNAME=oolshik
# NEON_DATASOURCE_PASSWORD=...

# ── RDS (prod) ───────────────────────────────────────────────────────────────
# RDS_HOSTNAME=...rds.amazonaws.com
# RDS_PORT=5432
# RDS_DB_NAME=oolshik
# RDS_USERNAME=oolshik
# RDS_PASSWORD=...

# ── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=CHANGEME_DEV_at_least_32_chars_long_123456

# ── ADMIN SEED ───────────────────────────────────────────────────────────────
ADMIN_EMAIL=admin@oolshik.app
ADMIN_PASSWORD=Admin@123

# ── OTP (msg91 — required for cloud-dev/prod) ────────────────────────────────
# APP_OTP_MSG91_API_KEY=...
# APP_OTP_MSG91_TEMPLATE_ID=...
# APP_OTP_MSG91_SENDER_ID=OOLSHK
# APP_OTP_MSG91_ENTITY_ID=...

# ── GOOGLE AUTH ──────────────────────────────────────────────────────────────
APP_AUTH_GOOGLE_ENABLED=true
APP_AUTH_GOOGLE_REQUIRE_PHONE=true
APP_AUTH_GOOGLE_AUTO_LINK_BY_EMAIL=true
APP_AUTH_GOOGLE_ALLOWED_CLIENT_IDS=
FIREBASE_PROJECT_ID=oolshik
FIREBASE_CHECK_REVOKED=false
# Path to Firebase service-account JSON on the host (docker-compose mounts this into the container)
FIREBASE_ADMIN_JSON_HOST_PATH=./secrets/oolshik-firebase-adminsdk-fbsvc-3f9053e5f1.json
GOOGLE_APPLICATION_CREDENTIALS=/secrets/firebase-sa.json

# ── KAFKA ────────────────────────────────────────────────────────────────────
# Only relevant when docker compose --profile full up with APP_MESSAGING_KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# ── STT ──────────────────────────────────────────────────────────────────────
STT_AUDIO_SOURCE_MODE=REQUEST
# STT_DEMO_AUDIO_URL=https://...
STT_REWRITE_LOCAL_PUBLIC_STREAM_FOR_WORKER=true
STT_LOCAL_WORKER_BASE_URL=https://oolshik.in
HF_TOKEN=

# ── MEDIA STORAGE ────────────────────────────────────────────────────────────
# MEDIA_STORAGE=local       # local disk (dev)
# MEDIA_STORAGE=s3          # S3 / DigitalOcean Spaces (cloud-dev / prod)
# MEDIA_S3_BUCKET=oolshik-audio
# MEDIA_S3_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...

# ── NOTIFICATIONS ─────────────────────────────────────────────────────────────
ADMIN_NOTIF_PUSH_PROVIDER=DISABLED   # DISABLED | FCM | EXPO
